<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.metadatacenter</groupId>
  <artifactId>cedar-artifact-mcp</artifactId>
  <version>1.0.1</version>
  <packaging>jar</packaging>

  <name>cedar-artifact-mcp</name>
  <description>
    MCP server that exposes the CEDAR artifact library's builders, readers, and renderers
    as composable tools. Consumes IRI/acronym/name tuples from upstream terminology MCPs
    (e.g. bioportal-term-mcp) and assembles CEDAR templates, elements, fields, and instances.
  </description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <cedar-artifact-library.version>2.8.4-SNAPSHOT</cedar-artifact-library.version>
    <mcp-sdk.version>1.1.3</mcp-sdk.version>
    <!--
      Jackson 3 (used by mcp-json-jackson3) deliberately keeps the annotations
      package at the 2.x group id (com.fasterxml.jackson.core:jackson-annotations)
      but requires a 3.x release that adds JsonFormat.Shape.POJO. The 2.17.2 jar
      pulled in transitively by cedar-artifact-library predates that constant, so
      we pin the 3.x annotations release here. Versions <3.0 throw
      NoSuchFieldError on the first inbound JSON-RPC message.
    -->
    <jackson-annotations.version>3.0-rc5</jackson-annotations.version>
    <junit.version>5.11.4</junit.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <dependencies>
    <!-- The CEDAR artifact library — the thing this MCP wraps. -->
    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-artifact-library</artifactId>
      <version>${cedar-artifact-library.version}</version>
    </dependency>

    <!-- Official MCP Java SDK. https://github.com/modelcontextprotocol/java-sdk -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>${mcp-sdk.version}</version>
    </dependency>

    <!--
      Pin jackson-annotations to a 3.x release so Jackson 3 databind (used by
      the MCP SDK) finds JsonFormat.Shape.POJO at runtime. See the comment on
      the property declaration above.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>${jackson-annotations.version}</version>
    </dependency>

    <!-- SLF4J binding for MCP SDK log output. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <!-- Tests. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Filter only the .version stamp so ${project.version} is interpolated into it at build
           time; copy every other resource verbatim, since filtering would corrupt templated
           markup that uses ${...}. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/*.version</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/*.version</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <!--
        Integration tests (*IT.java) spawn the shaded jar as a subprocess and
        speak real JSON-RPC over stdio. They run in the verify phase, after
        the shaded jar has been built.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.2</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Build an executable jar with dependencies bundled for easy MCP-client launch. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.metadatacenter.artifacts.mcp.ArtifactMcpServer</mainClass>
                </transformer>
                <!--
                  Multiple META-INF/services entries (e.g. McpJsonMapperSupplier,
                  JsonSchemaValidatorSupplier) must be merged, not overwritten,
                  for the MCP SDK's ServiceLoader-based wiring to work after shading.
                -->
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <!--
                cedar-model-library and cedar-model-validation-library are uber-jars
                that bundle Jackson 2.x annotation classes (com.fasterxml.jackson.annotation.*).
                Those bundled classes lack JsonFormat.Shape.POJO, which Jackson 3 (used by
                the MCP SDK) needs. Strip the bundled copies so the proper 3.x jar wins.
              -->
              <filters>
                <filter>
                  <artifact>org.metadatacenter:cedar-model-library</artifact>
                  <excludes>
                    <exclude>com/fasterxml/jackson/annotation/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>org.metadatacenter:cedar-model-validation-library</artifact>
                  <excludes>
                    <exclude>com/fasterxml/jackson/annotation/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Also emit a stable, version-less copy of the shaded jar (<artifactId>.jar) so a local
           MCP-client config can point at a fixed path that survives rebuilds and version bumps. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>stable-jar-name</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <copy file="${project.build.directory}/${project.build.finalName}-all.jar"
                      tofile="${project.build.directory}/${project.artifactId}.jar"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
